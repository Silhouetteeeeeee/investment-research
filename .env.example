# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# APP_API_TOKEN: at least 32 ASCII characters (e.g. openssl rand -hex 32).
APP_API_TOKEN=
DEEPSEEK_API_KEY=
# 可选：百度千帆 AI 搜索（每日 100 次免费）。为空时联网搜索直接走 DeepSeek Search。
BAIDU_API_KEY=
XQ_TOKEN=
# 可选：OpenTelemetry traces。留空 = 不启用（middleware 走 noop tracer）。
# 填 collector 根地址即可，代码自动补 /v1/traces（OTLP/HTTP 默认端口 4318）。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 可选：服务名与采样率（0..1，默认 1）；OTEL_SDK_DISABLED=true 可强制关闭。
OTEL_SERVICE_NAME=investment-research
OTEL_TRACES_SAMPLER_ARG=1
