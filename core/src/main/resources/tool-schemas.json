        }
      },
      "additionalProperties": false
    }
  },
  "get_management": {
    "name": "get_management",
    "description": "管理层与治理：董事会/高管/监事会/审计委员会成员，含职务、任期、年龄、学历、薪酬、持股与简历，以及各组薪酬与持股合计",
