        "company": {
          "type": "string",
          "description": "股票代码或简称；省略则用当前公司"
        }
      },
      "additionalProperties": false
    }
  },
  "get_segments": {
    "name": "get_segments",
    "description": "主营构成：按产品和按地区两组切片，含收入、占比、同比、毛利率，以及最近若干期同口径的分部历史，用来看业务结构变化",
