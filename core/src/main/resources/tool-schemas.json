          "type": "string",
          "description": "股票代码或简称；省略则用当前公司"
        }
      },
      "additionalProperties": false
    }
  },
  "get_dividends": {
    "name": "get_dividends",
    "description": "分红历史：按报告期列现金分红（税前每 10 股）、送股/转增、实施进度与除权除息日；按年度汇总现金分红总额、归母净利润与分红率，并给出连续分红年数。分红总额按报告期总股本估算，分红率按报告期归年",
    "parameters": {
      "type": "object",
      "properties": {
        "years": {
          "type": "integer",
          "description": "回看年数，1-20，默认 10"
        },
        "company": {
          "type": "string",
          "description": "股票代码或简称；省略则用当前公司"
        }
      },
      "additionalProperties": false
    }
  },
  "get_insider_trades": {
    "name": "get_insider_trades",
    "description": "高管增减持：列变动人、与高管的关系、职务、变动股数、成交均价、金额、变动后持股与原因；按年汇总净增持/净减持，按人汇总净额。持股计划单列，只含已披露记录",
    "parameters": {
      "type": "object",
      "properties": {
        "years": {
          "type": "integer",
