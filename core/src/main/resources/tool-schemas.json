{
  "load_skill": {
    "name": "load_skill",
    "description": "加载研究 skill 的完整判据与回答结构。可用：business_model（第一问：这家公司究竟靠什么赚钱？）；moat（第二问：竞争优势是什么？能持续多久？）；operating_history（第三问：过去 5–10 年的经营表现如何？）；financial_safety（第四问：财务安全吗？会不会因为一次危机就撑不住？）；growth_outlook（第五问：未来还能增长吗？增长从哪里来？）；management（第六问：管理层值得信任吗？）；valuation（第七问：它值多少钱？）；margin_of_safety（第八问：现在的价格有安全边际吗？）；market_view（大盘怎么看：指数、宽度、量能与操作节奏）；news_events（新闻与事件分析：政策、产业、公司与海外）；sector_rotation（行业轮动分析：强弱、持续性与反转信号）；stock_screening（候选股票筛选：量化初筛、基本面复核与估值排序）；strategy_risk（策略与风险管理：条件下的操作预案与仓位上限）；review_eval（复盘与预测评估：命中率、超额收益与失误归因）；research_memory（公司研究档案：事实、假设、结论变化与未决问题）。宏观问题可一次加载多个。",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "business_model",
            "moat",
            "operating_history",
            "financial_safety",
            "growth_outlook",
            "management",
            "valuation",
            "margin_of_safety",
            "market_view",
            "news_events",
            "sector_rotation",
            "stock_screening",
            "strategy_risk",
            "review_eval",
            "research_memory"
          ],
          "description": "要加载的 skill 名称"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "resolve_company": {
    "name": "resolve_company",
    "description": "把公司简称或代码解析成六位代码；重名或找不到时返回候选",
    "parameters": {
      "type": "object",
      "properties": {
        "name_or_code": {
          "type": "string",
          "description": "公司简称或六位股票代码"
        }
      },
      "required": [
        "name_or_code"
      ],
      "additionalProperties": false
    }
  },
  "get_company_profile": {
    "name": "get_company_profile",
    "description": "公司概况：主营描述、行业分类、员工数、经营范围摘要",
    "parameters": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "description": "股票代码或简称；省略则用当前公司"
        }
      },
      "additionalProperties": false
    }
  },
  "get_finance": {
    "name": "get_finance",
    "description": "财务快照：营收/净利及同比、毛利率、净利率、ROE、负债率、现金流、有息负债、利息保障、商誉、应收/存货同比；另含每股收益、归母净资产、固定资产/在建工程、应付/合同负债、投资收益与减值、研发与资本开支、单季趋势，以及 balance_detail / income_detail / cashflow_detail 三张表的完整科目（金额均为亿元）",
    "parameters": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "description": "股票代码或简称；省略则用当前公司"
        }
      },
      "additionalProperties": false
    }
  },
  "get_financial_history": {
    "name": "get_financial_history",
    "description": "年度财务序列：5–10 年的营收、净利、每股收益、毛利率、净利率、费用率、ROE、现金流、有息负债、固定资产/在建工程与负债率，用来看盈利能力能否持续",
    "parameters": {
      "type": "object",
      "properties": {
        "years": {
          "type": "integer",
          "description": "回看年数，1-10，默认 10"
